<?xml version="1.0" encoding="utf-8"?>
<!--
  Secondary ("Remind me later") alarm button: an outline, not a filled block.

  The visual weight difference is intentional. Both actions are equally
  available, but the design should not make deferring a dose as inviting as
  taking it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_btn_ghost_press" />
            <stroke android:width="2dp" android:color="@color/ds_btn_ghost_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="@color/ds_btn_ghost_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
