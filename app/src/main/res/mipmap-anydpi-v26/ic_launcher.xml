<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+). The launcher masks these two layers to whatever
     shape the device uses, so nothing important may sit outside the middle 66%
     of the foreground - see adaptive_foreground() in make_icons.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ds_brand" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
